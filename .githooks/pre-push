#!/usr/bin/env bash
# pre-push 钩子：推送前隐私/安全增量扫描（RULE-AI-28 push 闸的机械层）
# 背景（2026-10-29 事故）：知识卡携带内网 IP+用户名推上公开仓，pre-commit 的
# experiences/ 粒度豁免放行了内容——push 前必须再过一遍内容级隐私规则。
# 安装: git config core.hooksPath .githooks（与 pre-commit 同机制）
# 锚定钩子自身路径定位扫描脚本（不依赖被推仓库结构/worktree 根）

set -u

# 远端守卫（2026-10-29）：遗留归档仓一律拒推，fail-closed。
# 主防线是配置层 remote.legacy.pushurl=no-push://（--no-verify/GUI 也绕不过）；
# 本守卫覆盖未配 pushurl 的新 clone，并给出人话提示。按 URL 匹配，不依赖 remote 名。
REMOTE_NAME="${1:-}"
REMOTE_URL="${2:-}"
if [[ "$REMOTE_NAME" == "legacy" || "$REMOTE_URL" == *"llm-first-loop-legacy"* ]]; then
  echo "[pre-push] 拒绝：'${REMOTE_NAME:-?}' -> ${REMOTE_URL:-?} 是遗留归档仓，不是上游。" >&2
  echo "[pre-push] 上游是 github.com/deyi2026/llm-first-loop.git，其 remote 名为 origin；推送请: git push origin <ref>" >&2
  exit 1
fi

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCAN="$SELF_DIR/../scripts/git_security_scan.sh"
FLUSH="$SELF_DIR/../scripts/knowledge_flush.py"

# 知识资产闸（2026-11-09）：工作区存在未入库的方法卡/经验卡时拒推，fail-closed。
# 背景：data/methods/*/METHOD.md 与 experiences/*.md 在 .gitignore 里是入库例外，
# 但此前没有任何闸提醒过它们——卡片只活在本机工作区，换机/清工作区/新 clone 即静默
# 丢失。它们是学习资产，与代码同属发布面，故与隐私扫描同列在推送前判定。
# 判定异常（脚本缺失/退出码非 0/非 3）一律拒推：看不见的闸等于没有闸。
if [[ ! -f "$FLUSH" ]]; then
  echo "[pre-push] 拒绝：知识闸脚本缺失（${FLUSH}），无法判定，按 fail-closed 处理。" >&2
  echo "[pre-push] 修复：git checkout -- scripts/knowledge_flush.py" >&2
  exit 1
fi
python3 "$FLUSH" --check --quiet
FLUSH_RC=$?
if [[ "$FLUSH_RC" -eq 3 ]]; then
  echo "[pre-push] 拒绝：工作区有未入库的知识资产（方法卡/经验卡）。" >&2
  echo "[pre-push] 它们尚未进任何提交，脱离本机工作区就会消失。" >&2
  echo "[pre-push] 修复：python3 scripts/knowledge_flush.py   # 入库后重试推送" >&2
  exit 1
elif [[ "$FLUSH_RC" -ne 0 ]]; then
  echo "[pre-push] 拒绝：知识闸判定失败（exit=${FLUSH_RC}），按 fail-closed 处理。" >&2
  echo "[pre-push] 先手动跑一次排查：python3 scripts/knowledge_flush.py --check --json" >&2
  exit 1
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" =~ ^0+$ ]] && continue
  if [[ "$remote_sha" =~ ^0+$ ]]; then
    RANGE_ARGS=(--commit "$local_sha")   # 首推：扫待推提交可达的完整历史（逐提交，非仅 tip 树）
  else
    RANGE_ARGS=(--range "$remote_sha" "$local_sha")
  fi
  echo "[pre-push] $local_ref -> $remote_ref  (${RANGE_ARGS[*]})"
  bash "$SCAN" "${RANGE_ARGS[@]}" || exit 1
done
exit 0
