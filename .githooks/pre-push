#!/usr/bin/env bash
# pre-push 钩子：推送前隐私/安全增量扫描（RULE-AI-28 push 闸的机械层）
# 背景（2026-10-29 事故）：知识卡携带内网 IP+用户名推上公开仓，pre-commit 的
# experiences/ 粒度豁免放行了内容——push 前必须再过一遍内容级隐私规则。
# 安装: git config core.hooksPath .githooks（与 pre-commit 同机制）
# 锚定钩子自身路径定位扫描脚本（不依赖被推仓库结构/worktree 根）

set -u

# 远端守卫（2026-10-29）：遗留归档仓一律拒推，fail-closed。
# 主防线是配置层 remote.legacy.pushurl=no-push://（--no-verify/GUI 也绕不过）；
# 本守卫覆盖未配 pushurl 的新 clone，并给出人话提示。按 URL 匹配，不依赖 remote 名。
REMOTE_NAME="${1:-}"
REMOTE_URL="${2:-}"
if [[ "$REMOTE_NAME" == "legacy" || "$REMOTE_URL" == *"llm-first-loop-legacy"* ]]; then
  echo "[pre-push] 拒绝：'${REMOTE_NAME:-?}' -> ${REMOTE_URL:-?} 是遗留归档仓，不是上游。" >&2
  echo "[pre-push] 上游是 github.com/deyi2026/llm-first-loop.git，其 remote 名为 origin；推送请: git push origin <ref>" >&2
  exit 1
fi

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCAN="$SELF_DIR/../scripts/git_security_scan.sh"
FLUSH="$SELF_DIR/../scripts/knowledge_flush.py"

# 知识资产闸（2026-11-09）：工作区存在未入库的方法卡/经验卡时拒推，fail-closed。
# 背景：data/methods/*/METHOD.md 与 experiences/*.md 在 .gitignore 里是入库例外，
# 但此前没有任何闸提醒过它们——卡片只活在本机工作区，换机/清工作区/新 clone 即静默
# 丢失。它们是学习资产，与代码同属发布面，故与隐私扫描同列在推送前判定。
# 判定异常（脚本缺失/退出码非 0/非 3）一律拒推：看不见的闸等于没有闸。
if [[ ! -f "$FLUSH" ]]; then
  echo "[pre-push] 拒绝：知识闸脚本缺失（${FLUSH}），无法判定，按 fail-closed 处理。" >&2
  echo "[pre-push] 修复：git checkout -- scripts/knowledge_flush.py" >&2
  exit 1
fi
python3 "$FLUSH" --check --quiet
FLUSH_RC=$?
if [[ "$FLUSH_RC" -eq 3 ]]; then
  echo "[pre-push] 拒绝：工作区有未入库的知识资产（方法卡/经验卡）。" >&2
  echo "[pre-push] 它们尚未进任何提交，脱离本机工作区就会消失。" >&2
  echo "[pre-push] 修复：python3 scripts/knowledge_flush.py   # 入库后重试推送" >&2
  exit 1
elif [[ "$FLUSH_RC" -ne 0 ]]; then
  echo "[pre-push] 拒绝：知识闸判定失败（exit=${FLUSH_RC}），按 fail-closed 处理。" >&2
  echo "[pre-push] 先手动跑一次排查：python3 scripts/knowledge_flush.py --check --json" >&2
  exit 1
fi

# 回执完整性闸（EVO-20261109-b1dad92e P5）：回执是交付证据，正文仍写「待回填」
# 说明交付链没闭合（本次合并回执曾因此卡住 push）。口径与知识闸一致：判定异常
# fail-closed（看不见的闸等于没有闸）。
RECEIPT_DIR="docs/governance/receipts"
# 新落点（2026-11-10，用户指示）：RULE-AI-28 回执的正式目录。
# 与 governance 目录的区别：docs/receipts/ 不在任何 ignore 规则内（由
# tests/unit/test_receipts_dir_versioned.py 断言），普通 git add 就能入库——
# 因此「未跟踪」不再只是「待检查」，而是「写了没入库，会随换机/清工作区消失」。
NEW_RECEIPT_DIR="docs/receipts"
receipt_hit=0
check_receipt_content() {
  local label="$1" body="$2" hits
  hits="$(printf '%s\n' "$body" | grep -n '待回填' || true)"
  if [[ -n "$hits" ]]; then
    echo "[pre-push] 拒绝：回执 ${label} 仍含「待回填」占位。" >&2
    printf '%s\n' "$hits" | head -5 | sed 's/^/    /' >&2
    receipt_hit=1
  fi
}

# 工作区未跟踪回执：合并回执常先生成、后随推送入库，这类最容易被漏。
if ! untracked_receipts="$(git ls-files --others --exclude-standard -- "$RECEIPT_DIR")"; then
  echo "[pre-push] 拒绝：无法枚举未跟踪回执（fail-closed）。" >&2
  exit 1
fi
while IFS= read -r f; do
  [[ -n "$f" ]] || continue
  # 残余②（2026-11-09 收口）：读失败（如权限）不再静默按空内容放行——fail-closed，
  # 与枚举失败同处置；看不见内容的闸等于没有闸。
  if ! untracked_body="$(cat "$f" 2>/dev/null)"; then
    echo "[pre-push] 拒绝：无法读取未跟踪回执 ${f}（fail-closed）。" >&2
    echo "[pre-push] 修复：恢复该文件可读，或入库/删除后重推。" >&2
    receipt_hit=1
    continue
  fi
  check_receipt_content "${f}（未跟踪）" "$untracked_body"
done <<< "$untracked_receipts"

# 新落点未入库闸（2026-11-10）：docs/receipts/ 的回执未跟踪即拒推，fail-closed。
# 旧落点 docs/promotion/ 被 .git/info/exclude 整目录遮住，git add 静默收不进、
# 漏加不报错——这正是本次换落点要根治的失败模式；这里把「写了没入库」变成
# 推送前的显式失败。只判 *.json：README 等说明文档不属于回执。
if ! untracked_new_receipts="$(git ls-files --others --exclude-standard -- "$NEW_RECEIPT_DIR")"; then
  echo "[pre-push] 拒绝：无法枚举 docs/receipts 未跟踪文件（fail-closed）。" >&2
  exit 1
fi
while IFS= read -r f; do
  [[ -n "$f" ]] || continue
  [[ "$f" == *.json ]] || continue
  echo "[pre-push] 拒绝：回执 ${f} 未入库（未跟踪）。" >&2
  echo "[pre-push] 修复：git add ${f}   # 该目录未被忽略，无需 -f；或删除不需要的回执" >&2
  receipt_hit=1
done <<< "$untracked_new_receipts"

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" =~ ^0+$ ]] && continue
  RANGE_ARGS=(--commit "$local_sha")
  TAG_RANGE_SCAN=0
  SKIP_SOURCE_SCAN=0
  RECEIPT_TREE_SHA="$local_sha"
  if [[ "$local_ref" == refs/tags/* ]]; then
    # 标签创建/更新均按目标 commit 与远端受保护 main 的关系判定：
    # - 目标恰等于 main：没有新代码；main 推送增量闸 + CI --tree 已覆盖，不重扫；
    # - 目标是 main 的旧祖先：扫精确目标树，防止旧 tag 指向后来已删除的敏感内容；
    # - 目标领先 main：扫描 main..tag 的每个新增提交，再扫 tag 完整目标树；
    # - 无法证明关系/对象缺失/历史分叉：回退完整 --commit 扫描，fail-closed。
    if ! TAG_TARGET_SHA="$(git rev-parse --verify --quiet "${local_sha}^{commit}")"; then
      echo "[pre-push] 拒绝：标签目标无法解析为 commit（fail-closed）。" >&2
      exit 1
    fi
    REMOTE_MAIN_LINE="$(git ls-remote --heads "$REMOTE_URL" refs/heads/main 2>/dev/null || true)"
    REMOTE_MAIN_SHA="${REMOTE_MAIN_LINE%%$'\t'*}"
    RECEIPT_TREE_SHA="$TAG_TARGET_SHA"
    if [[ "$REMOTE_MAIN_SHA" =~ ^[0-9a-f]{40,64}$ ]] \
      && git cat-file -e "${REMOTE_MAIN_SHA}^{commit}" 2>/dev/null; then
      if git merge-base --is-ancestor "$REMOTE_MAIN_SHA" "$TAG_TARGET_SHA" 2>/dev/null; then
        if [[ "$REMOTE_MAIN_SHA" == "$TAG_TARGET_SHA" ]]; then
          # Tagging the exact commit already on main changes no source bytes.
          # The main push pre-push delta scan and required CI full-tree scan
          # are the trust evidence; repeating the same 8k-file tree scan is
          # redundant. Receipt completeness checks above still run.
          SKIP_SOURCE_SCAN=1
          echo "[pre-push] 标签目标与远端 main 完全相同：无代码增量，复用 main 推送/CI 安全检查。" >&2
        else
          RANGE_ARGS=(--tree-commit "$TAG_TARGET_SHA")
          TAG_RANGE_ARGS=(--range "$REMOTE_MAIN_SHA" "$TAG_TARGET_SHA")
          TAG_RANGE_SCAN=1
          echo "[pre-push] 标签使用已推送 main 基线：精确树 + main 之后的新增提交。" >&2
        fi
      elif git merge-base --is-ancestor "$TAG_TARGET_SHA" "$REMOTE_MAIN_SHA" 2>/dev/null; then
        RANGE_ARGS=(--tree-commit "$TAG_TARGET_SHA")
        echo "[pre-push] 标签目标已包含在远端 main：只扫描该标签的精确树，不重扫已接受历史。" >&2
      else
        RANGE_ARGS=(--commit "$local_sha")
        echo "[pre-push] 标签与远端 main 历史分叉：回退完整历史扫描。" >&2
      fi
    else
      RANGE_ARGS=(--commit "$local_sha")
      echo "[pre-push] 无法证明远端 main 基线：回退完整历史扫描。" >&2
    fi
    if ! changed_receipts="$(git ls-tree -r --name-only "$RECEIPT_TREE_SHA" -- "$RECEIPT_DIR" "$NEW_RECEIPT_DIR")"; then
      echo "[pre-push] 拒绝：无法枚举首推回执（fail-closed）。" >&2
      exit 1
    fi
  elif [[ "$remote_sha" =~ ^0+$ ]]; then
    # 新分支首推：仅信任本次 origin push URL 的真实远端 main，且须为
    # local_sha 的已存在 commit 祖先。否则沿用完整历史扫描，绝不静默放行。
    RANGE_ARGS=(--commit "$local_sha")
    RECEIPT_TREE_SHA="$local_sha"
    REMOTE_MAIN_LINE=""
    if [[ "$REMOTE_NAME" == "origin" \
      && "$REMOTE_URL" == "$(git remote get-url --push origin 2>/dev/null)" ]]; then
      REMOTE_MAIN_LINE="$(git ls-remote --heads "$REMOTE_URL" refs/heads/main 2>/dev/null)" || REMOTE_MAIN_LINE=""
    fi
    REMOTE_MAIN_SHA="${REMOTE_MAIN_LINE%%$'\t'*}"
    # Git push origin HEAD:refs/heads/name supplies local_ref=HEAD, not
    # refs/heads/name. Trust it only when HEAD is a named local branch and
    # resolves to the exact SHA Git is pushing; detached/mismatched HEAD
    # retains the full-history fail-closed scan.
    TRUSTED_LOCAL_BRANCH_REF=0
    if [[ "$local_ref" == refs/heads/* ]]; then
      TRUSTED_LOCAL_BRANCH_REF=1
    elif [[ "$local_ref" == "HEAD" ]]; then
      HEAD_BRANCH="$(git symbolic-ref -q HEAD 2>/dev/null || true)"
      HEAD_COMMIT="$(git rev-parse --verify 'HEAD^{commit}' 2>/dev/null || true)"
      if [[ "$HEAD_BRANCH" == refs/heads/* && "$HEAD_COMMIT" == "$local_sha" ]]; then
        TRUSTED_LOCAL_BRANCH_REF=1
      fi
    fi
    if [[ "$TRUSTED_LOCAL_BRANCH_REF" == 1 && "$remote_ref" == refs/heads/* \
      && "$REMOTE_MAIN_LINE" == "$REMOTE_MAIN_SHA"$'\t'"refs/heads/main" \
      && "$REMOTE_MAIN_SHA" =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]] \
      && git cat-file -e "${REMOTE_MAIN_SHA}^{commit}" 2>/dev/null \
      && git merge-base --is-ancestor "$REMOTE_MAIN_SHA" "$local_sha" 2>/dev/null; then
      RANGE_ARGS=(--range "$REMOTE_MAIN_SHA" "$local_sha")
      if ! changed_receipts="$(git diff --name-only --diff-filter=AMRC "$REMOTE_MAIN_SHA" "$local_sha" -- "$RECEIPT_DIR" "$NEW_RECEIPT_DIR")"; then
        echo "[pre-push] 拒绝：无法枚举新分支增量回执（fail-closed）。" >&2
        exit 1
      fi
      echo "[pre-push] 新分支首推：远端 main 祖先已核验，逐提交增量扫描。" >&2
    else
      if ! changed_receipts="$(git ls-tree -r --name-only "$RECEIPT_TREE_SHA" -- "$RECEIPT_DIR" "$NEW_RECEIPT_DIR")"; then
        echo "[pre-push] 拒绝：无法枚举首推回执（fail-closed）。" >&2
        exit 1
      fi
      echo "[pre-push] 新分支首推：无可信远端 main 祖先，保留完整历史扫描。" >&2
    fi
  else
    RANGE_ARGS=(--range "$remote_sha" "$local_sha")
    # 残余③（2026-11-09 收口）：AM 对 rename+modify 的回执为空漏检；AMRC 取新路径
    # （--name-only 对 R/C 只列新名，旧名已不在 tip、无需扫）。
    if ! changed_receipts="$(git diff --name-only --diff-filter=AMRC "$remote_sha" "$local_sha" -- "$RECEIPT_DIR" "$NEW_RECEIPT_DIR")"; then
      echo "[pre-push] 拒绝：无法计算回执变更集（fail-closed）。" >&2
      exit 1
    fi
  fi
  # 本次 range 新增/修改的回执：逐文件读 blob，命中占位即拒推。
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    # 新落点的非 JSON 文件（README/说明）不是回执，不参与占位判定。
    if [[ "$f" == "$NEW_RECEIPT_DIR"/* && "$f" != *.json ]]; then
      continue
    fi
    if ! body="$(git show "${local_sha}:${f}" 2>/dev/null)"; then
      echo "[pre-push] 拒绝：无法读取回执 ${f}@${local_sha:0:12}（fail-closed）。" >&2
      receipt_hit=1
      continue
    fi
    check_receipt_content "$f@${local_sha:0:12}" "$body"
  done <<< "$changed_receipts"
  if [[ "$TAG_RANGE_SCAN" == "1" ]]; then
    echo "[pre-push] $local_ref -> $remote_ref  (${TAG_RANGE_ARGS[*]})"
    bash "$SCAN" "${TAG_RANGE_ARGS[@]}" || exit 1
  fi
  if [[ "$SKIP_SOURCE_SCAN" != "1" ]]; then
    echo "[pre-push] $local_ref -> $remote_ref  (${RANGE_ARGS[*]})"
    bash "$SCAN" "${RANGE_ARGS[@]}" || exit 1
  fi
done

if [[ "$receipt_hit" -ne 0 ]]; then
  echo "[pre-push] 修复：回填 main_sha_after / verify_receipt_id 等占位字段后重试推送。" >&2
  echo "[pre-push] 说明：回执占位不阻断本地提交，只阻断推送（避免带着未闭合证据发布）。" >&2
  exit 1
fi
exit 0
