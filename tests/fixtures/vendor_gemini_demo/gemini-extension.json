{
  "name": "gemini-demo", "version": "0.3.1", "description": "demo gemini extension",
  "mcpServers": {
    "http-srv": {"httpUrl": "https://example.com/mcp", "headers": {"Authorization": "Bearer tok"}},
    "legacy-sse": {"url": "https://example.com/sse"},
    "toolbox": {"command": "tbx", "args": ["--n", "5"], "cwd": "/tmp/x", "timeout": 5000, "trust": true, "excludeTools": ["danger"]}
  },
  "contextFileName": "GEMINI.md",
  "settings": [{"name": "API key", "envVar": "GEMINI_API_KEY", "sensitive": true}],
  "excludeTools": ["shell"]
}
