# LLM API 配置（LLM_API_KEY / LLM_BASE_URL 必填；LLM_MODEL 缺省默认 deepseek-v4-flash）
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-v4-flash  # 可选: deepseek-v4-flash（默认，官方 V4-Flash-0731）/ deepseek-v4-pro（更强档）
# 模型缺省链: LLM_MODEL 显式 > OPENSYGAI_DEEPSEEK_DEFAULT_MODEL > deepseek-v4-flash
# WEB_MODELS=deepseek-v4-flash,deepseek-v4-pro  # Web 端模型切换候选（逗号分隔；缺省内置两档）

# M20 LLM 思考模式（DeepSeek V4；非 DeepSeek provider 自动不发）
# LLM_THINKING_MODE=enabled    # 思考模式开关: enabled/disabled（默认 enabled）
# LLM_REASONING_EFFORT=high    # 推理强度: low/high/max（默认 high；v4-pro 暂支持 high/max 两档）

# 循环控制（可选）
LLM_MAX_ITERATIONS=40
LLM_TIMEOUT_S=120
LLM_MAX_TOKENS=8192  # 2026-08-15: 显式输出预算（思考链模型思考占预算，8192 防长分析被 4096 默认截断；provider 级可覆盖）

# 数据目录（可选，默认 ./data）
DATA_DIR=./data
# docs/ 文档检索目录（可选，默认 ./docs；search_docs 工具扫描此目录下 *.md）
DOCS_DIR=./docs
# B3: 插件化 Skill 目录（可选，默认 ./skills；放 skills/<name>/SKILL.md 即被 AI 发现，
# 经 skill_list/skill_load 工具加载执行；目录不存在=零行为）
SKILLS_DIR=./skills

# 工具（可选）
TOOL_TIMEOUT_S=60
TOOL_MAX_OUTPUT_CHARS=20000
# 历史分层降级（EVO-20260811-7baa2737，可选）
TOOL_TRIM_ENABLED=1
# tool_trim 自适应降级年龄（0=自适应：按占用率自动调 <40%→20/40-70%→10/>70%→5；>0=固定值禁用自适应）
TOOL_TRIM_AGE=0
TOOL_TRIM_THRESHOLD=800  # EVO-A: 旧 tool 消息超此字符数降级为首尾摘要（原文归档可检索）；越小越省 token

# 上下文（可选）
# HISTORY_MAX_CHARS = AI 侧 adjust_strategy 参数 history_budget 的初始默认值（默认 100000，AI 调整后动态覆盖）
# 1M 窗口模型可调大（如 300000）；预算过高会撑爆窗口导致所有模型调用失败
HISTORY_MAX_CHARS=80000
MEMORY_TOP_K=5
# R7: 压缩档案 GC（0=不限；启动时自动清理一次防磁盘膨胀）
ARCHIVE_MAX_ENTRIES=0
ARCHIVE_TTL_DAYS=0
# T3b: 档案单文件分片阈值（字节；默认 104857600=100MB，0=不分片；超阈值开 <sid>-N.jsonl 新段）
ARCHIVE_SEGMENT_BYTES=104857600
# P1-3: 审计 JSONL 条目存活天数（0=不清理；启动时自动清理过期条目）
AUDIT_TTL_DAYS=30
# P1-5: 记忆条目上限（0=不限；超限自动淘汰 decay_score 最低的条目）
MEMORY_MAX_ENTRIES=0

# 架构自省（可选，默认开启）
SELF_INSPECTION_ENABLED=1
STATUS_REPORT_COOLDOWN_S=60

# ── P1 LLM 摘要（SUMMARY_MODE: off=确定性/sync=同步/async=后台，默认 off 零回归）──
SUMMARY_MODE=off
SUMMARY_TIMEOUT_S=30
SUMMARY_MAX_INPUT_CHARS=20000
# R6: 独立摘要模型（provider/model 引用，如 deepseek/deepseek-v4-flash；空=用主模型）
# 用于成本隔离：摘要用便宜/专用模型，主链路用高性能模型
SUMMARY_MODEL=

# ── P1 语义检索（EMBEDDING_PROVIDER: none=关闭/hash=本地/api=OpenAI 兼容端点）──
EMBEDDING_PROVIDER=none
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_DIM=128
RETRIEVE_TIMEOUT_S=1.0
RETRIEVE_SEMANTIC_TOP_K=20

# ── P1 独立记忆提取（EXTRACT_ENABLED=0 时仅即时 [[memory]] 沉淀）──
EXTRACT_ENABLED=1
EXTRACT_INTERVAL_MSGS=20
REASONING_TAIL=2   # M66 思考链瘦身: 提交历史中仅保留最近 N 轮 assistant 思考链（0=全部保留）
EXTRACT_COOLDOWN_S=600
EXTRACT_MAX_INPUT_CHARS=30000
EXTRACT_TIMEOUT_S=60

# ── P1 声明-回执语义匹配（默认关，P0 关键词/路径匹配兜底）──
VALIDATE_SEMANTIC=0
VALIDATE_SEMANTIC_THRESHOLD=0.75

# ── M12 AI 自主闭环（默认值保零回归）──

SELFHEAL_MAX_ATTEMPTS=3
SELFHEAL_MAX_PER_ROUND=6
PARAM_ADJUST_PER_ROUND=3

EVOLVE_ENABLED=1

# ── M12 深化·演进建议自动落地执行（EXEC，默认 0=仅建议，P0/P1 零回归）──
# EVOLVE_LOCAL_EXEC: 演进执行权限三级 0=仅建议（AI 只提交建议，执行由人工完成）/
#   1=白名单局部执行（仅白名单内 accepted 演进自动执行）/ 2=全面执行（不涉边界皆可自动执行，仍受 EXEC-03 边界约束）
# 旧布尔值兼容: EVOLVE_LOCAL_EXEC=1（True）平滑升级为级别 1；非法值回退 0
EVOLVE_LOCAL_EXEC=0
# 执行白名单（级别 1 时生效；逗号分隔影响范围/模块/动作类型，默认空=未配置则不自动执行）
#   例: "recover_state,clear_cache,timeout_s"
EVOLVE_EXEC_WHITELIST=

# ── M12 深化·AI 自我评估与改进（EVAL，默认仅提醒不强制）──
# SELF_EVAL_ENABLED: 自我评估能力总开关（self_evaluate 工具）
SELF_EVAL_ENABLED=1
# SELF_EVAL_REMIND_ENABLED: 触发提醒开关（定期/里程碑/异常三类触发，仅提示不强制，决策权归 LLM）
SELF_EVAL_REMIND_ENABLED=1
# 定期触发间隔（轮）: rounds % SELF_EVAL_INTERVAL_ROUNDS == 0 触发提醒
SELF_EVAL_INTERVAL_ROUNDS=50
# 样本不足阈值: 指标样本数 < 此值 → value=None + 如实标注"样本不足"
SELF_EVAL_MIN_SAMPLES=5
# 聚合窗口: 近 N 条动作/工具/校验记录 + 近 N 轮异常聚合
SELF_EVAL_SPAN=50

# ── EXEC_MODE 命令分级（EVO-20260810-2549e9b6，可选安全配置）──
# 默认不设置 = 不启用分级（AI 可执行 shell，仅灾难性硬阻断；对齐四原则④不限制大模型发挥）
# readonly=只读命令放行 / allowlist=白名单 / blocked=全禁（安全收紧时设置）
# EXEC_MODE=
# allowlist 模式的命令前缀白名单（逗号分隔，如: ls,cat,git status）
EXEC_ALLOWLIST=


# ── M42 飞书桥（FEISHU_APP_ID / FEISHU_APP_SECRET 必填；缺失则桥不启用）──
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
# FEISHU_WS_ENABLED: 0=关闭 WS 长连接（飞书桥不启动），默认 1
FEISHU_WS_ENABLED=1
# FEISHU_SESSION_MAP_PATH=./data/feishu_session_map.json  # 会话映射文件（默认 DATA_DIR 下）
# FEISHU_CHUNK_LIMIT=50000    # 长回复 markdown 分段阈值（默认 50000，最小 200）
# ── M46 处理中动作显示（对齐 本地既有实现 命名）──
# FEISHU_TYPING_ACK=1   # 0=关闭 Typing reaction 回执（收到消息加 Typing 表情，回复后删除）
# FEISHU_STREAMING=1    # 0=关闭流式状态卡（收到消息建 ⏳ 处理中卡，完成定稿）
# FEISHU_OWNER_OPEN_ID=ou_xxx # 跨端共享：owner 私聊与 Web 共享同一会话（一端说话另一端能感知上下文；空=不启用，各私聊独立）

# ── M49 Fallback 降级链（design §5.4，可选容错配置）──
# MODEL_FALLBACKS='deepseek/deepseek-v4-flash,local/qwen3.6-27b-fable-fusion-711-uncensored-heretic-nm-dau-neo-max-mtp,minimax/MiniMax-M3'
# 行为规则表（design §5.4）:
#   - 当前模型为默认装配 → 失败 (timeout/网络/5xx/429) 自动沿链尝试下一个, 回执 [模型降级: X→Y, 原因: ...]
#   - 当前模型为会话显式 override（用户/AI 经 switch_model 选择）→ 严格模式, 失败如实反馈不降级
#   - 链全部失败 → 汇总每个候选失败原因如实反馈, 不静默
#   - 4xx (非 429) 不降级: 请求本身有问题, 换模型无用
# 未设置/空 = 不启用降级（零回归；失败直接如实反馈, 与 M49 之前行为一致）
# 非法条目（未知 provider/model/裸名歧义/api_key 缺失）→ 跳过 + logging.warning, 不影响链上其他候选
# architecture_status.model_fallback 可见当前是否处于降级态 + 降级原因（有则显示, 无则全 None）
# 密钥安全（DFX-SEC-02）: 仅注册表已配置的 provider/model 可参与降级; 密钥从 env var 按需读取, 不落日志/回执/审计

# ── M50 三端一致性 + providers.json 热重载（design §5.6 / §六）──
# 启停 Web 模型切换候选过滤（仅当 WEB_MODELS 设置时起作用）:
#   - 未设置 = Web 端候选从 MODEL_PROVIDERS / data/providers.json 自动生成 (注册表全量)
#   - 设置 = Web 端候选 = 注册表 ∩ WEB_MODELS (过滤子集)
#   - 改造前: WEB_MODELS = 硬列表 (未设置默认两道提)
#   - 改造后: WEB_MODELS = 过滤子集 (未设置 = 注册表全量), 零回归
# WEB_MODELS=deepseek/deepseek-v4-flash,minimax/MiniMax-M3
#
# data/providers.json 热重载 (M50 §5.6):
#   - AI 可以经 refresh_config 工具重读 providers.json (不必重启)
#   - 回执示例: [重载完成] 模型目录已从 2 个 provider / 3 个模型 变为 3 个 provider / 4 个模型。
#   - 加载失败 → 保持旧 registry + 如实标注
#   - 优先级: MODEL_PROVIDERS env > data/providers.json > L0 合成
# data/providers.json 示例 (同 MODEL_PROVIDERS schema):
#   {
#     "deepseek": {
#       "base_url": "https://api.deepseek.com/v1",
#       "api_key_env": "DEEPSEEK_API_KEY",
#       "models": {
#         "deepseek-v4-flash": {"context": 1000000, "thinking": true, "cost_tier": "low"},
#         "deepseek-v4-pro":   {"context": 1000000, "thinking": true, "cost_tier": "high"}
#       },
#       "default_model": "deepseek-v4-flash"
#     }
#   }
#
# M50 三端一致的 /model 指令（CLI / 飞书桥 / Web 切换）:
#   - CLI: 启动参数 --model provider/model              写会话 override (即时生效)
#          交互模式 /model [provider/model | default]  查 / 切 / 清除 (与 Web 共享 session store)
#   - 飞书: 消息命令 /model /model <ref> /model default  走 handler 拦截, 复用同一 session
#   - Web:  POST /api/v1/chat body.model = provider/model  透传 per-call override
#   - 单一真相源: SessionStore.model_override ()一字段, 三端读写同一份
#   - 密钥安全: 切捼过程中回执不含 key / base_url, 审计与日志同样不记录

# T3: Web 长文本折叠阈值（前端默认值，AI 无感；不配置时用默认值正常运行）
LONG_LINE_THRESHOLD=200
LONG_CHAR_THRESHOLD=20000

# T5: 会话级并发锁（默认开启，同会话串行不同会话并行；false 退化为无锁向后兼容）
SESSION_CONCURRENCY_LOCK=true

# ── EVO-20260813-432813b2: AI 主动出站飞书（涉安全边界，默认禁用） ──
# FEISHU_OUTBOUND_ENABLED: AI 主动发飞书消息/创建文档/发送附件的总开关（默认 false）
#   必须显式设为 true 才允许 AI 主动出站，避免误操作
FEISHU_OUTBOUND_ENABLED=false
# FEISHU_OUTBOUND_ALLOWED_USERS: 接收方白名单（逗号分隔 open_id），空=全部拒绝
#   仅向列表内的飞书用户发送，杜绝 AI 给陌生人发消息
# FEISHU_OUTBOUND_ALLOWED_USERS=ou_xxx,ou_yyy
# FEISHU_OUTBOUND_RATE_PER_MIN: 单接收方速率限制（条/分钟，默认 5），防风暴
FEISHU_OUTBOUND_RATE_PER_MIN=5
# FEISHU_AUDIT_DIR: 出站审计日志目录（默认 data/audit，feishu_outbound.jsonl 记录每次主动出站）
# FEISHU_AUDIT_DIR=./data/audit

# ── CodeArts 子 Agent 调度集成（design §2.1.2，缺省 fail-open 零装配）──
# CODEARTS_ENABLED: 总开关（false=不装配，对现有运行时零影响；true=需凭证+端点）
CODEARTS_ENABLED=false
# CODEARTS_ENDPOINT: CodeArts OpenAPI 端点（必须 HTTPS；禁止 http://）
# CODEARTS_ENDPOINT=https://codearts.cn-north-4.myhuaweicloud.com
# CODEARTS_REGION: 区域（默认 cn-north-4；按区域独立端点路由）
CODEARTS_REGION=cn-north-4
# CODEARTS_PROJECT_ID: 项目 ID（启用时必填）
# CODEARTS_PROJECT_ID=
# CODEARTS_AK: Access Key（敏感：仅 env 读取，不落盘不日志不命令行参数）
# CODEARTS_AK=
# CODEARTS_SK: Secret Key（敏感：仅 env 读取，不落盘不日志不命令行参数）
# CODEARTS_SK=
# CODEARTS_IAM_TOKEN: IAM Token（敏感：仅 env 读取；与 AK/SK 二选一）
# CODEARTS_IAM_TOKEN=
# CODEARTS_API_VERSION: OpenAPI 版本（默认 v1）
CODEARTS_API_VERSION=v1
# CODEARTS_CONNECT_TIMEOUT_S: 连接超时秒（默认 10）
CODEARTS_CONNECT_TIMEOUT_S=10
# CODEARTS_CALL_TIMEOUT_S: 调用超时秒（默认 30）
CODEARTS_CALL_TIMEOUT_S=30
# CODEARTS_EXEC_TIMEOUT_S: 执行超时秒（默认 1800=30min）
CODEARTS_EXEC_TIMEOUT_S=1800
# CODEARTS_POLL_INTERVAL_S: 轮询间隔秒（下限 5s，默认 5）
CODEARTS_POLL_INTERVAL_S=5
# CODEARTS_MAX_CONCURRENT: 并发上限（spec §4.1.5，默认 10）
CODEARTS_MAX_CONCURRENT=10
# CODEARTS_MAX_RETRIES: 最大重试次数（默认 3）
CODEARTS_MAX_RETRIES=3
# CODEARTS_RESULT_MAX_BYTES: 结果体积上限字节（超限截断+标注，默认 1MB）
CODEARTS_RESULT_MAX_BYTES=1048576
# CODEARTS_WEBHOOK_ENABLED: Webhook 事件接收开关（默认 false）
CODEARTS_WEBHOOK_ENABLED=false
# CODEARTS_WEBHOOK_SECRET: Webhook 签名密钥（敏感：仅 env 读取，用于 HMAC 校验）
# CODEARTS_WEBHOOK_SECRET=
# CODEARTS_APPROVAL_REQUIRED: 灾难性动作是否需人工审批（默认 true；CLI 交互注入弹窗，无人值守 fail-closed）
CODEARTS_APPROVAL_REQUIRED=true
# 最小可用配置示例:
#   CODEARTS_ENABLED=true
#   CODEARTS_ENDPOINT=https://codearts.cn-north-4.myhuaweicloud.com
#   CODEARTS_REGION=cn-north-4
#   CODEARTS_PROJECT_ID=your-project-id
#   CODEARTS_AK=your-ak
#   CODEARTS_SK=your-sk
