  "interpretation": {
    "cache": "provider-default cache was observed, not controlled; cache_prompt is absent on the resolved DeepSeek wire. Cache/token values are descriptive, not a promotion gate",
    "edit_control": "both arms are 1/3 exact-first FCR because two repeats start with search_files before read_file(snapshot=true); correctness remains 3/3 in both arms, so this control is symmetric but the exact-first oracle is stricter than the natural task",
    "target_signal": "host-portability failure rows fell from 4/9 to 1/9; no B-only portability failure pair was observed",
    "tokens": "median portability uncached input improves, but the paired mean worsens because one B row has a large +7438-token outlier; token benefit is not established",
    "wrong_tool_holdout": "all 6 rows per arm selected the pre-registered exact first tool, so the holdout proves no regression but provides no wrong-tool error-reduction headroom"
  },
  "limitations": [
    "single resolved model/provider: deepseek/deepseek-flash",
    "current runtime default cognilocal/qwen3.8-flash-next not yet replicated",
    "three repeats per task; portability discordance is directional rather than high-power statistical evidence",
    "provider-default cache not experimentally controlled",
    "wrong-tool prompts explicitly constrain the intended tool and therefore test adherence more than natural discovery",
    "edit-control exact-first oracle treats search_files prelude as a miss even though it can be a legitimate locator step"
  ],
