{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lfl.local/schemas/lfl.peer.v1/grant.schema.json",
  "title": "LFL Peer Grant (lfl.peer.v1)",
  "description": "有界租约。expires_at 与 max_tasks_total 必填，不允许永久/无限。issued_by.kind 为常量不构成安全边界：真实约束是运行时拒绝非真人 ingress 签发（对齐 RULE-AI-14）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "grant_id", "node_id", "issued_by", "issued_at", "expires_at", "state", "allowed_kinds", "allowed_paths", "max_concurrency", "max_tasks_total", "tasks_used"],
  "properties": {
    "schema": { "const": "lfl.peer.v1" },
    "grant_id": { "type": "string", "pattern": "^gr_[A-Za-z0-9]{8,40}$" },
    "node_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "issued_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "session_id"],
      "properties": {
        "kind": { "const": "human_ingress" },
        "session_id": { "type": "string", "minLength": 4, "maxLength": 128 },
        "at": { "type": "string", "format": "date-time" }
      }
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "state": { "enum": ["active", "expired", "exhausted", "revoked"] },
    "allowed_kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 512, "pattern": "^/" }
    },
    "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 8 },
    "max_tasks_total": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "tasks_used": { "type": "integer", "minimum": 0 },
    "revoked_at": { "type": "string", "format": "date-time" },
    "revoked_by": { "type": "string", "maxLength": 128 },
    "note": { "type": "string", "maxLength": 300 }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "revoked" } }, "required": ["state"] },
      "then": { "required": ["revoked_at"] }
    }
  ]
}
