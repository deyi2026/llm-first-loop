  "qualification_gate_map": {
    "B0": {
      "spec_requirement": "SMC-only model surface; legacy Playwright direct model access absent or counted as intervention.",
      "implementation_required_later": true
    },
    "B1": {
      "spec_requirement": "runtime/page/document/frame scope hierarchy, generation and invalidation are explicit.",
      "implementation_required_later": true
    },
    "B2": {
      "spec_requirement": "snapshot binds sensor contract, integrity, completeness/projection and hydratable grounding.",
      "implementation_required_later": true
    },
    "B3": {
      "spec_requirement": "identity policy is task-invariant and refuses ambiguous replacement rebinding.",
      "implementation_required_later": true
    },
    "B4": {
      "spec_requirement": "DOM/AX observations are source-qualified; C28 conflict wire is canonical.",
      "implementation_required_later": true
    },
    "B5": {
      "spec_requirement": "diff semantics/comparability/field completeness are explicit.",
      "implementation_required_later": true
    },
    "B6": {
      "spec_requirement": "actions accept semantic targets only; backend locators are not model-facing.",
      "implementation_required_later": true
    },
    "B7": {
      "spec_requirement": "dispatch re-resolves identity and checks expected_version/version_scope.",
      "implementation_required_later": true
    },
    "B8": {
      "spec_requirement": "idempotency/atomicity/retry facts are fixed by verb contract and auditable.",
      "implementation_required_later": true
    },
    "B9": {
      "spec_requirement": "receipts are append-only and revisioned by monotonic receipt_seq.",
      "implementation_required_later": true
    },
    "B10": {
      "spec_requirement": "Predicate vocabulary is structured, typed and tri-state with sampling facts.",
      "implementation_required_later": true
    },
    "B11": {
      "spec_requirement": "blind spots and boundary events are explicit; vision is never auto-triggered.",
      "implementation_required_later": true
    },
    "B12": {
      "spec_requirement": "closed surface rejects strategy fields, best-candidate recovery and task relevance authority.",
      "implementation_required_later": false
    },
    "B13": {
      "spec_requirement": "all non-DEFERRED R3 Phase1 scenarios map to deterministic implementation fixtures before qualification.",
      "implementation_required_later": true
    },
    "B14": {
      "spec_requirement": "committed candidate must pass focused/adjacent/static/security/full repo qualification.",
      "implementation_required_later": true
    }
  },
